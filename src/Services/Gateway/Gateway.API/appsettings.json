{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GatewayOptions": {
    "Audience": "agentgate-gateway",
    "Bootstrap": true,
    "AnomalyThreshold": 5,
    "AnomalyWindowSeconds": 60,
    "RegistryAddress": "https+http://registry",
    "ReviewAddress": "https+http://review"
  },
  "ServiceIdentityOptions": {
    "TokenEndpoint": "https+http://keycloak/realms/agentgate/protocol/openid-connect/token",
    "ClientId": "agentgate-gateway-service"
  }
}
