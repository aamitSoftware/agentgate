{
  "realm": "agentgate",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "registry-admin",
        "description": "Registers MCP servers and agents"
      },
      {
        "name": "security-reviewer",
        "description": "Reviews manifests and approves grants (four-eyes)"
      },
      {
        "name": "auditor",
        "description": "Read-only access to the hub and audit trail"
      },
      {
        "name": "snapshot-reader",
        "description": "Service-to-service: may call Registry's GetServerSnapshot (Review only)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "agentgate-console",
      "name": "AgentGate Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "demo-agent",
      "name": "Demo agent (nonhuman identity)",
      "description": "DEV ONLY. The secret below exists only in this local realm import.",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-rkU5VZ5fq7QWDiVRKw0q2Bf2",
